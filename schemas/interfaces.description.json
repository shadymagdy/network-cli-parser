{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/shadymagdy/network-cli-parser/main/schemas/interfaces.description.json",
  "title": "clijson interfaces.description",
  "description": "Interface descriptions with state.",
  "type": "array",
  "items": {
    "type": "object",
    "description": "Interface descriptions with state.",
    "properties": {
      "name": {
        "type": "string"
      },
      "admin_status": {
        "type": "string",
        "description": "up | down | admin-down (vendor word if unrecognised)"
      },
      "oper_status": {
        "type": "string",
        "description": "up | down | admin-down (vendor word if unrecognised)"
      },
      "description": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "name",
      "admin_status",
      "oper_status",
      "description"
    ],
    "additionalProperties": false
  }
}
