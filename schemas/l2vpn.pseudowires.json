{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/shadymagdy/network-cli-parser/main/schemas/l2vpn.pseudowires.json",
  "title": "clijson l2vpn.pseudowires",
  "description": "L2VPN pseudowires (VPLS/VSI peers, bridge-domain PWs, xconnects, l2circuits) with redundancy role.",
  "type": "array",
  "items": {
    "type": "object",
    "description": "L2VPN pseudowires (VPLS/VSI peers, bridge-domain PWs, xconnects, l2circuits) with redundancy role.",
    "properties": {
      "service": {
        "type": [
          "string",
          "null"
        ],
        "description": "VSI, bridge-domain, xconnect or attachment-circuit name the PW belongs to"
      },
      "neighbor": {
        "type": [
          "string",
          "null"
        ],
        "description": "Remote PE address (null when the output omits it, e.g. a row filtered with | match)"
      },
      "pw_id": {
        "type": [
          "integer",
          "null"
        ],
        "description": "PW / VC ID"
      },
      "state": {
        "type": "string",
        "description": "up, down or standby (vendor word lowercased if unrecognised)"
      },
      "role": {
        "type": [
          "string",
          "null"
        ],
        "description": "primary or backup, when PW redundancy is configured"
      },
      "active": {
        "type": [
          "boolean",
          "null"
        ],
        "description": "True when the PW is forwarding, False when standby / inactive"
      },
      "vc_type": {
        "type": [
          "string",
          "null"
        ],
        "description": "PW type, e.g. ethernet, ethernet-vlan"
      },
      "mtu": {
        "type": [
          "integer",
          "null"
        ],
        "description": "Negotiated / local PW MTU"
      },
      "local_label": {
        "type": [
          "integer",
          "null"
        ]
      },
      "remote_label": {
        "type": [
          "integer",
          "null"
        ]
      },
      "status_code": {
        "type": [
          "string",
          "null"
        ],
        "description": "Native status as printed: Junos Up / RS / HS ..., VRP FORWARD / up, IOS XR up / standby"
      },
      "local_status_code": {
        "type": [
          "string",
          "null"
        ],
        "description": "Local PW status code (hex string, e.g. 0x00000000)"
      },
      "remote_status_code": {
        "type": [
          "string",
          "null"
        ],
        "description": "Remote (neighbor) PW status code (hex string, e.g. 0x00000020)"
      },
      "control_word": {
        "type": [
          "boolean",
          "null"
        ],
        "description": "Control word negotiated / in use"
      },
      "pw_status_tlv": {
        "type": [
          "boolean",
          "null"
        ],
        "description": "PW status TLV negotiated / in use"
      },
      "flow_label_tx": {
        "type": [
          "boolean",
          "null"
        ],
        "description": "Flow label (FAT) transmit"
      },
      "flow_label_rx": {
        "type": [
          "boolean",
          "null"
        ],
        "description": "Flow label (FAT) receive"
      }
    },
    "required": [
      "service",
      "neighbor",
      "pw_id",
      "state",
      "role",
      "active",
      "vc_type",
      "mtu",
      "local_label",
      "remote_label",
      "status_code",
      "local_status_code",
      "remote_status_code",
      "control_word",
      "pw_status_tlv",
      "flow_label_tx",
      "flow_label_rx"
    ],
    "additionalProperties": false
  }
}
